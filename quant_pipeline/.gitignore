# Python virtual environment.
.venv/
__pycache__/
*.pyc
.pytest_cache/

# dbt build artifacts and the local warehouse.
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
*.duckdb
*.duckdb.wal

# Pipeline outputs.
output/

# The root .gitignore ignores every data/ folder. Keep this one: it holds
# the raw prices that dbt reads.
!data/
# The download cache. quant.ingest can make it again.
data/cache/
# A temporary price file for development.
data/*.stand_in.parquet
# Download logs. quant.ingest writes them again.
*.log
